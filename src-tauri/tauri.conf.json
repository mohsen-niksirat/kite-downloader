{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite",
  "version": "0.1.0",
  "identifier": "com.kitedownloader.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kite Downloader",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/icon.png"]
  }
}
